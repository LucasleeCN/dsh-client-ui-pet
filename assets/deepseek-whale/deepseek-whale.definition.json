    "done": {
      "label": "完成",
      "hold": false
    },
    "error": {
      "label": "担心",
      "hold": false
    },
    "happy": {
      "label": "开心",
      "hold": false
    },
    "eat": {
      "label": "吃饭",
      "hold": false
    },
    "play": {
      "label": "玩耍",
      "hold": false
